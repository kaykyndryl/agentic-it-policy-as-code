{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Local Test",
      "type": "shell",
      "command": "python",
      "args": ["test_local.py"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start HTTP Server",
      "type": "shell",
      "command": "python",
      "args": ["-m", "src.main"],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Format Code",
      "type": "shell",
      "command": "python",
      "args": ["-m", "black", "src/", "test_local.py"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Lint Code",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pylint", "src/"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
